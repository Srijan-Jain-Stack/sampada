# Example environment variables for local development
# Copy to .env and adjust

# FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=60

# Database
DATABASE_URL=sqlite:///./sampada.db

# Simulator
SIM_SEED=42

# Safety defaults (example/demo values)
SAFETY_MIN_TANK_LEVEL=10.0
SAFETY_MAX_IRRIGATION_MINUTES=60
SAFETY_MIN_BATTERY_LEVEL=10.0
